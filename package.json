{
  "name": "note-review-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Research prototype: patients review and correct an AI-drafted visit note before it is finalized. Fictional data only.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4174",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:a11y": "node e2e/a11y.mjs",
    "test:flow": "node e2e/flow.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
